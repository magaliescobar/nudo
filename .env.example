# Copiá este archivo a `.env.local` en la RAÍZ del monorepo (no en apps/web) y completá los valores.
# `.env.local` nunca se commitea. En Vercel/producción las variables se cargan en el entorno con los mismos nombres.

# --- Datos (obligatorias, §3.7) ----------------------------------------------
# MongoDB Atlas. Si el path no incluye base de datos se usa `nudo`.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/nudo
# Redis compartido por todas las instancias (caché L2, carrito, rate limit, idempotencia).
# En contenedores (Fase 2) el compose reemplaza solo el host `localhost` por `host.docker.internal`.
REDIS_URL=redis://localhost:6379

# --- Redis / caché ------------------------------------------------------------
# `tcp` (cliente node-redis sobre REDIS_URL) | `rest` (Redis por HTTP en serverless).
REDIS_DRIVER=tcp
# Caché L1 en memoria con invalidación por pub/sub. `false` en serverless (Vercel).
CACHE_L1_PUBSUB=true

# --- Seguridad ----------------------------------------------------------------
# Secreto compartido de endpoints internos (revalidación, scripts catalog:*). Generalo con `openssl rand -hex 32`.
INTERNAL_API_SECRET=<secreto-aleatorio>
# Clave AES (base64, 32 bytes) idéntica en todas las instancias para Server Actions. `openssl rand -base64 32`.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<clave-base64>
# Identificador de build común a todas las instancias (detecta version skew).
NEXT_DEPLOYMENT_ID=<id-de-build>

# --- Sitio --------------------------------------------------------------------
# URL pública canónica (metadataBase, sitemap, hreflang).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
