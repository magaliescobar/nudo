{
  "name": "@nudo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    "./atoms/*": "./src/atoms/*/*.tsx",
    "./molecules/*": "./src/molecules/*/*.tsx",
    "./organisms/*": "./src/organisms/*/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@nudo/config": "workspace:*",
    "@types/react": "^19",
    "react": "19.3.0"
  }
}
